{{!-- The header is the move handle; its move cursor is the only sign. The header tooltips open upward, so they do
     not cover the tiles. --}}
<header class="tha-picker-header" data-tooltip-direction="UP">
  <span class="tha-picker-title">{{localize "TOKEN_HOVER_ART.Picker.Title" name=tokenName}}</span>
  {{#if isMoved}}
  <button type="button" class="tha-picker-button active" data-tha-action="reset-position" aria-pressed="true"
          aria-label="{{localize "TOKEN_HOVER_ART.Picker.ResetPosition"}}">
    <i class="fas fa-thumbtack" aria-hidden="true"></i>
  </button>
  {{/if}}
  {{#if isGM}}
  {{!-- The only tooltip: the icon cannot say who still sees secret art. --}}
  <button type="button" class="tha-picker-button {{#if secret}}active{{/if}}" data-tha-action="secret"
          aria-pressed="{{#if secret}}true{{else}}false{{/if}}" aria-label="{{localize "TOKEN_HOVER_ART.Picker.Secret"}}"
          data-tooltip="{{#if secret}}TOKEN_HOVER_ART.Picker.SecretOn{{else}}TOKEN_HOVER_ART.Picker.SecretOff{{/if}}">
    <i class="fas {{#if secret}}fa-eye-slash{{else}}fa-eye{{/if}}" aria-hidden="true"></i>
  </button>
  {{/if}}
  {{#if canManage}}
  <button type="button" class="tha-picker-button" data-tha-action="manage"
          aria-label="{{localize "TOKEN_HOVER_ART.Picker.Manage"}}">
    <i class="fas fa-cog" aria-hidden="true"></i>
  </button>
  {{/if}}
  <button type="button" class="tha-picker-button" data-tha-action="close"
          aria-label="{{localize "TOKEN_HOVER_ART.Picker.Close"}}">
    <i class="fas fa-times" aria-hidden="true"></i>
  </button>
</header>
{{!-- Each breadcrumb part opens its category and takes drops (picker-drag-drop.mjs). --}}
<nav class="tha-picker-nav" aria-label="{{localize "TOKEN_HOVER_ART.Picker.Breadcrumb"}}">
  <ol class="tha-breadcrumb">
    {{#each breadcrumb}}
    <li>
      <button type="button" class="tha-breadcrumb-part" data-tha-action="navigate" data-category-id="{{id}}"
              data-tha-drop data-tha-focus-key="crumb:{{id}}" {{#if isCurrent}}aria-current="location"{{/if}}>
        {{#if isRoot}}{{localize "TOKEN_HOVER_ART.Picker.Root"}}{{else}}{{name}}{{/if}}
      </button>
    </li>
    {{/each}}
  </ol>
  <button type="button" class="tha-picker-button" data-tha-action="new-category" data-tha-focus-key="new-category"
          aria-haspopup="dialog" aria-label="{{localize "TOKEN_HOVER_ART.Picker.NewCategory"}}">
    <i class="fas fa-folder-plus" aria-hidden="true"></i>
  </button>
</nav>
<div class="tha-picker-grid">
  {{#each categories}}
  <div class="tha-tile" draggable="true" data-tha-drag="category" data-category-id="{{id}}" data-tha-drop
       data-tha-tile-key="category:{{id}}">
    <button type="button" class="tha-choice tha-category {{#if containsSelection}}tha-holds-selection{{/if}}"
            data-tha-action="open-category" data-category-id="{{id}}" data-tha-focus-key="category:{{id}}">
      <i class="fas fa-folder" aria-hidden="true"></i>
      <span class="tha-category-name">{{name}}</span>
    </button>
    <button type="button" class="tha-tile-menu" data-tha-action="tile-menu"
            data-tha-focus-key="menu:category:{{id}}" aria-haspopup="menu"
            aria-label="{{localize "TOKEN_HOVER_ART.Picker.TileMenu" name=name}}">
      <i class="fas fa-ellipsis-v" aria-hidden="true"></i>
    </button>
  </div>
  {{/each}}
  {{#if isRoot}}
  {{!-- "No hover art" cannot be marked or moved; it is a drag source for the hotbar only. --}}
  <div class="tha-tile" {{#if canDragToHotbar}}draggable="true" data-tha-drag="asset"{{/if}}>
    <button type="button" class="tha-choice tha-choice-none {{#unless hasSelection}}active{{/unless}}"
            data-tha-action="clear" data-tha-focus-key="none"
            aria-pressed="{{#if hasSelection}}false{{else}}true{{/if}}"
            aria-label="{{localize "TOKEN_HOVER_ART.Picker.None"}}">
      <i class="fas fa-ban" aria-hidden="true"></i>
    </button>
  </div>
  {{/if}}
  {{#each images}}
  <div class="tha-tile" draggable="true" data-tha-drag="asset" data-path="{{path}}" data-tha-tile-key="asset:{{path}}">
    <button type="button" class="tha-choice {{#if active}}active{{/if}}" data-tha-action="select"
            data-path="{{path}}" data-tha-focus-key="asset:{{path}}"
            aria-pressed="{{#if active}}true{{else}}false{{/if}}" aria-label="{{name}}">
      {{#if isVideo}}
      <video src="{{path}}" muted loop autoplay playsinline aria-hidden="true"></video>
      {{else}}
      <img src="{{path}}" alt="" loading="lazy" draggable="false">
      {{/if}}
    </button>
    <button type="button" class="tha-tile-menu" data-tha-action="tile-menu"
            data-tha-focus-key="menu:asset:{{path}}" aria-haspopup="menu"
            aria-label="{{localize "TOKEN_HOVER_ART.Picker.TileMenu" name=name}}">
      <i class="fas fa-ellipsis-v" aria-hidden="true"></i>
    </button>
  </div>
  {{/each}}
</div>
{{#if isEmpty}}
<p class="tha-picker-empty">
  {{#if isRoot}}{{localize "TOKEN_HOVER_ART.Picker.Empty"}}{{else}}{{localize "TOKEN_HOVER_ART.Picker.CategoryEmpty"}}{{/if}}
</p>
{{/if}}
<div class="tha-picker-resize" aria-hidden="true"></div>
